{
  "model": "diffusers/stable-diffusion-xl-1.0-inpainting-0.1",
  "settings": {
    "prompt": "A snack packet on a matte blue tabletop, solid dark blue background, blue studio backdrop, commercial product photography.",
    "negative_prompt": "extra products, people, hands, watermark, clutter, blurry",
    "num_inference_steps": 25,
    "guidance_scale": 7.5,
    "strength": 1.0,
    "width": 768,
    "height": 768
  },
  "seeds": [
    42,
    123
  ],
  "products": [
    "Coca_Cola",
    "Coffee_cup",
    "Doritos",
    "KitKat",
    "Mount_Franklin",
    "Oreo",
    "Pringles",
    "Red_Bull",
    "Red_Rock_Deli",
    "Smiths_Orginal"
