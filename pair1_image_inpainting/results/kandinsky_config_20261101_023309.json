{
  "model": "kandinsky-community/kandinsky-2-2-decoder-inpaint",
  "prior_model": "kandinsky-community/kandinsky-2-2-prior",
  "prompt": "A snack packet on a matte blue tabletop, solid dark blue background, blue studio backdrop, commercial product photography.",
  "negative_prompt": "extra products, people, hands, watermark, clutter, blurry",
  "decoder_settings": {
    "height": 768,
    "width": 768,
    "num_inference_steps": 25,
    "guidance_scale": 7.5
  },
  "seeds": [
    42,
    123
  ],
  "products": [
    "Coca_Cola",
    "Coffee_cup",
    "Doritos",
    "KitKat",
    "Mount_Franklin",
    "Oreo",
    "Pringles",
    "Red_Bull",
    "Red_Rock_Deli",
    "Smiths_Orginal"
  ],
  "scheduler": "DDPMScheduler",
  "scheduler_config": {
    "num_train_timesteps": 1000,
    "beta_start": 0.00085,
    "beta_end": 0.012,
    "beta_schedule": "linear",
    "trained_betas": null,
    "variance_type": "fixed_small",
    "clip_sample": false,
    "prediction_type": "epsilon",
    "thresholding": false,
    "dynamic_thresholding_ratio": 0.995,
    "clip_sample_range": 1.0,
    "sample_max_value": 1.0,
    "timestep_spacing": "leading",
    "steps_offset": 1,
    "rescale_betas_zero_snr": false,
    "_use_default_values": [
      "timestep_spacing",
      "dynamic_thresholding_ratio",
      "sample_max_value",
      "clip_sample_range",
      "rescale_betas_zero_snr",
      "trained_betas",
      "variance_type"
    ],
    "_class_name": "DDPMScheduler",
    "_diffusers_version": "0.17.0.dev0",
    "set_alpha_to_one": false
  },
  "timing_note": "Decoder timed per output; prior embeddings cached."
}